# Frontend-safe variables only. Never put AWS or AI provider secrets in VITE_* variables.
VITE_API_BASE_URL=http://127.0.0.1:3001

# Backend AI Intelligence Layer Configuration (Server-Side Only)
# AI_PROVIDER: 'deterministic' (default, local, no API keys or cloud calls needed) or 'external'
AI_PROVIDER=deterministic
AI_MODEL=deterministic-rules-v1
AI_API_KEY=
AI_BASE_URL=
AI_TIMEOUT_MS=10000
AI_MAX_OUTPUT_TOKENS=2048

# Future AWS Cloud Integration (Out of scope for Milestone 4; explicitly not provisioned)
# AWS_REGION=ap-south-1
# BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
# DYNAMODB_WASTE_TABLE=Waste2WattWasteRecords
# DYNAMODB_ANALYSIS_TABLE=Waste2WattAnalyses
# S3_REPORTS_BUCKET=waste2watt-reports
