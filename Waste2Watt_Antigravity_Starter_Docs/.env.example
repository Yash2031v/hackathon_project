# Frontend-safe variables only. Never put AWS secrets in VITE_* variables.
VITE_API_BASE_URL=http://localhost:3000

# Backend configuration (keep in server-side environment / AWS configuration)
AWS_REGION=ap-south-1
BEDROCK_MODEL_ID=replace-with-a-model-available-in-your-region
DYNAMODB_WASTE_TABLE=Waste2WattWasteRecords
DYNAMODB_ANALYSIS_TABLE=Waste2WattAnalyses
S3_REPORTS_BUCKET=replace-after-approved-provisioning
AI_PROVIDER=mock
