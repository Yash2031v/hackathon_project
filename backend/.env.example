# Waste2Watt Backend Environment Configuration
PORT=3001
STORAGE_TYPE=file
DATA_DIR=./data
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Explainable AI Intelligence Configuration (Milestone 4)
# Provider mode: 'deterministic' (default, local, zero API key) or 'external' (optional HTTP provider)
AI_PROVIDER=deterministic
AI_MODEL=deterministic-rules-v1
AI_API_KEY=
AI_BASE_URL=
AI_TIMEOUT_MS=10000
AI_MAX_OUTPUT_TOKENS=2048
